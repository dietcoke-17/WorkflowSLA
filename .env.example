# WorkflowSLA Configuration
# Database Connection:
# Default is SQLite for instant zero-dependency local execution:
DATABASE_URL=sqlite:///./workflowsla.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflowsla

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Default Financial Guesstimate Simulation Variables
DEFAULT_AVERAGE_ORDER_VALUE=45.0
DEFAULT_DAILY_TRANSACTIONS=10000
DEFAULT_REVENUE_DROP_PER_HOUR=0.005
DEFAULT_OPERATIONAL_COST_PER_HOUR=65.0
DEFAULT_CURRENCY=USD
# For Indian Rupee / Lakhs display benchmarks:
# DEFAULT_CURRENCY=INR
# DEFAULT_AVERAGE_ORDER_VALUE=3500.0

